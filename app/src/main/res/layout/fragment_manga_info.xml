<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <data>
        <variable
            name="viewModel"
            type="ru.garretech.readmanga.ui.manga.viewModel.MangaAboutViewModel" />
    </data>

<FrameLayout
        android:id="@+id/movie_info_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorPrimary"
        android:fillViewport="true"
        tools:context=".ui.manga.MangaAboutFragment">

    <include
            android:id="@+id/manga_info_progress_circle"
            layout="@layout/progressbar_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
                android:id="@+id/manga_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/manga_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="Заголовок манги"
                    android:textAlignment="center"
                    android:textSize="22sp" />

            <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/line_divider" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <ImageView
                        android:id="@+id/manga_image_about"
                        android:layout_width="160dp"
                        android:layout_height="210dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginStart="@dimen/activity_horizontal_margin"
                        android:layout_marginTop="@dimen/activity_vertical_margin"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:layout_marginBottom="@dimen/activity_vertical_margin" />

                <View
                        android:id="@+id/divider3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/line_divider" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                    <TextView
                            android:id="@+id/manga_genres_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Жанры:"
                            android:textSize="18sp" />

                    <TextView
                            android:id="@+id/manga_production_country_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.currentManga.productionCountry}"
                            android:textSize="18sp" />

                    <TextView
                            android:id="@+id/manga_chapters_number_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Серий:"
                            android:textSize="18sp" />

                    <TextView
                            android:id="@+id/manga_duration_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.currentManga.duration}"
                            android:textSize="18sp" />

                    <TextView
                            android:id="@+id/manga_age_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@{viewModel.currentManga.productionYear}"
                            android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>

            <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/line_divider" />

            <TextView
                    android:id="@+id/manga_description_text"
                    android:text="@{viewModel.currentManga.description}"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/activity_horizontal_margin"
                    android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>

</layout>